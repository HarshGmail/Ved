# Copy to .env.local. Both values are baked into the JavaScript bundle at build
# time, so changing them needs a restart (dev) or a rebuild (deploy).

# Where the browser reaches the backend.
NEXT_PUBLIC_VED_API_URL=http://localhost:8000

# Public half of the push key pair. Written here automatically by
# apps/backend/scripts/generate_vapid_keys.py. Public by design; the private
# half stays in apps/backend/.env.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Phone access over Tailscale. Written by ./ved phone; not exposed to the
# browser. Lets the Next dev server accept requests from your tailnet hostname.
# VED_TAILNET_HOST=
