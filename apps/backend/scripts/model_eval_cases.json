    {"prompt": "Remind me what I told you about my dentist appointment last week", "expect_tool": "memory.search", "expect_args": {"query": null}},
    {"prompt": "Pichle hafte humne Goa trip ke baare mein kya baat ki thi?", "expect_tool": "memory.search", "expect_args": {"query": null}},
    {"prompt": "What's the latest forecast for the Indian monsoon?", "expect_tool": "web.search", "expect_args": {"query": null}},
    {"prompt": "Search the web for the best rated air purifiers under 15000 rupees", "expect_tool": "web.search", "expect_args": {"query": null}},
    {"prompt": "Hi, how are you?", "expect_tool": null, "expect_args": {}},
    {"prompt": "Explain the difference between a Roth IRA and a traditional IRA in two sentences", "expect_tool": null, "expect_args": {}},
    {"prompt": "Write a haiku about rain", "expect_tool": null, "expect_args": {}},
