    {"prompt": "Create a task to send the invoice to Ravi by Friday", "expect_tool": "create_task", "expect_args": {"title": null, "dueDate": null}},
    {"prompt": "Play Coldplay on the TV", "expect_tool": "tv.play_media", "expect_args": {"query": null}},
    {"prompt": "Coldplay ka koi gana TV pe chalao", "expect_tool": "tv.play_media", "expect_args": {"query": null}},
    {"prompt": "Turn off the TV", "expect_tool": "tv.power", "expect_args": {"action": "off"}},
