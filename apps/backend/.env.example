# Copy to .env for running the backend in a terminal.
# When running via infra/compose.yaml these are supplied by the container.

# Replace the second "ved" with POSTGRES_PASSWORD from infra/.env.
VED_DATABASE_URL=postgresql+psycopg://ved:ved@localhost:5432/ved

# Comma-separated origins allowed to call the API, as a JSON list.
VED_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Which LLM drives the agent.
#   stub               deterministic fake, no model needed — used by the tests
#   openai-compatible  any OpenAI-shaped /v1 endpoint (Ollama, LM Studio,
#                      llama.cpp, vLLM, OpenRouter, a GPU box on the LAN)
VED_LLM_PROVIDER=openai-compatible

# Where that endpoint lives. Swapping runtimes is a URL change, nothing more.
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
VED_LLM_BASE_URL=http://localhost:11434/v1
VED_LLM_MODEL=qwen3.6:35b

# Only needed for hosted endpoints. Local runtimes ignore it.
# VED_LLM_API_KEY=

# 0 keeps tool arguments deterministic; raise it for chattier prose.
VED_LLM_TEMPERATURE=0.0

# A cold local model has to load into memory before the first token.
VED_LLM_TIMEOUT_SECONDS=120.0

# Used to turn "remind me at 8 PM" into a timestamp with a real UTC offset.
VED_TIMEZONE=Asia/Kolkata

# Stops a model that keeps calling tools without ever answering.
VED_AGENT_MAX_TOOL_ROUNDS=8

# Web Push. Generate with: uv run python scripts/generate_vapid_keys.py
# The private key never leaves this machine; rotating it drops all subscriptions.
# VED_VAPID_PUBLIC_KEY=
# VED_VAPID_PRIVATE_KEY=
VED_VAPID_SUBJECT=mailto:ved@example.com

# How often due reminders are checked. A reminder can fire up to this late.
VED_SCHEDULER_POLL_SECONDS=30

# Local time birthday reminders arrive, on the day and on the early notice.
VED_BIRTHDAY_REMINDER_TIME=09:00

# Embeddings for searching past conversations. Pull the model once:
#   ollama pull nomic-embed-text
# The dimension is fixed by the database column (vector(768)); switching to a
# model with a different size needs a migration and re-embedding every message.
VED_EMBEDDING_MODEL=nomic-embed-text
VED_EMBEDDING_DIMENSIONS=768
