# Copy to infra/.env and set a real password before the first `docker compose up`.
# The db container bakes this into its data volume on first run.

POSTGRES_USER=ved
POSTGRES_PASSWORD=
POSTGRES_DB=ved
POSTGRES_PORT=5432

BACKEND_PORT=8000
VED_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# The containerized backend needs its own copy of the push keys — Compose reads
# this file, not apps/backend/.env. Copy the values generated by
# apps/backend/scripts/generate_vapid_keys.py. Without them the container runs
# with push disabled and due reminders are only logged.
VED_VAPID_PUBLIC_KEY=
VED_VAPID_PRIVATE_KEY=
VED_VAPID_SUBJECT=mailto:ved@example.com

VED_LLM_MODEL=qwen3.6:35b
VED_SCHEDULER_POLL_SECONDS=30

# Which engine the containerized backend's web.search uses. The search
# container below only starts under the "search" compose profile.
VED_SEARCH_PROVIDER=searxng

# SearXNG, the private metasearch engine behind web.search. ./ved db fills
# SEARXNG_SECRET with a random value the first time it starts SearXNG; it signs
# SearXNG's own cookies and never needs to match anything else. Postgres and
# the backend start without it.
SEARXNG_SECRET=
SEARXNG_PORT=8888
