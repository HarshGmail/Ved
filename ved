#!/usr/bin/env bash
# Short commands for running Ved. Run `./ved help` for the list.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INFRA="$ROOT/infra"
BACKEND="$ROOT/apps/backend"
WEB="$ROOT/apps/web-client"
REMINDERS="$ROOT/mcp-servers/reminders"
PEOPLE="$ROOT/mcp-servers/people"
MEMORY="$ROOT/mcp-servers/memory"
WEB_TOOLS="$ROOT/mcp-servers/web"
SEARCH_CA_DIR="$INFRA/searxng/ca-certificates"
VM_CA_DIR="/usr/local/share/ca-certificates"

OLLAMA_PORT=11434
BACKEND_PORT=8000
WEB_PORT=3000
SEARCH_PORT=8888
SEARXNG_PROVIDER="searxng"
SEARCH_PROFILE="search"
PHONE_WEB_PORT=443
PHONE_API_PORT=8443
TAILSCALE_APP_CLI="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
DEFAULT_MODEL="qwen3.6:35b"
EMBEDDING_MODEL="nomic-embed-text"

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
fail() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

compose() {
  (cd "$INFRA" && docker compose "$@")
}

is_macos() { [ "$(uname -s)" = "Darwin" ]; }

port_in_use() {
  if command -v ss >/dev/null 2>&1; then
    ss -Htln "sport = :$1" 2>/dev/null | grep -q .
  else
    lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  fi
}

ensure_docker() {
  if is_macos; then
    if ! colima status >/dev/null 2>&1; then
      say "starting Colima"
      colima start
    fi
  elif ! docker info >/dev/null 2>&1; then
    fail "Docker is not running or not usable by $(id -un). See docs/server.md"
  fi
}

replace_in_file() {
  if is_macos; then
    sed -i '' "$1" "$2"
  else
    sed -i "$1" "$2"
  fi
}

configured_model() {
  local configured
  configured="$(sed -n 's/^VED_LLM_MODEL=//p' "$BACKEND/.env" 2>/dev/null | tail -n 1)"
  configured="$(printf '%s' "$configured" | tr -d "\"' ")"
  printf '%s' "${configured:-$DEFAULT_MODEL}"
}

ensure_env_files() {
  [ -f "$INFRA/.env" ] || fail "infra/.env missing. Run ./ved setup first."
  [ -f "$BACKEND/.env" ] || fail "apps/backend/.env missing. Run ./ved setup first."
}

find_tailscale() {
  if command -v tailscale >/dev/null 2>&1; then
    command -v tailscale
  elif [ -x "$TAILSCALE_APP_CLI" ]; then
    printf '%s' "$TAILSCALE_APP_CLI"
  fi
  return 0
}

tailnet_hostname() {
  "$1" status --json --peers=false 2>/dev/null |
    sed -n 's/^ *"DNSName": *"\(.*\)\.",*$/\1/p' |
    head -n 1 || true
}

set_env_value() {
  local file="$1" key="$2" value="$3"
  [ -f "$file" ] || touch "$file"
  if grep -q "^$key=" "$file"; then
    replace_in_file "s|^$key=.*|$key=$value|" "$file"
  else
    [ -z "$(tail -c 1 "$file")" ] || printf '\n' >>"$file"
    printf '%s=%s\n' "$key" "$value" >>"$file"
  fi
}

allow_cors_origin() {
  local file="$1" origin="$2" current merged
  current="$(sed -n 's/^VED_CORS_ALLOW_ORIGINS=//p' "$file" 2>/dev/null | head -n 1)"
  merged="$(python3 - "$current" "$origin" "http://localhost:$WEB_PORT" <<'PY'
import json
import sys

current, origin, local_origin = sys.argv[1].strip(), sys.argv[2], sys.argv[3]
try:
    origins = json.loads(current) if current else [local_origin]
except json.JSONDecodeError:
    sys.exit(f"VED_CORS_ALLOW_ORIGINS is not a JSON list: {current}")
if not isinstance(origins, list):
    sys.exit(f"VED_CORS_ALLOW_ORIGINS is not a JSON list: {current}")
if origin not in origins:
    origins.append(origin)
print(json.dumps(origins, separators=(",", ":")))
PY
)" || fail "could not update CORS in $file"
  set_env_value "$file" VED_CORS_ALLOW_ORIGINS "$merged"
}

ensure_search_secret() {
  if ! grep -q '^SEARXNG_SECRET=.' "$INFRA/.env"; then
    say "generating the SearXNG secret in infra/.env"
    set_env_value "$INFRA/.env" SEARXNG_SECRET "$(openssl rand -hex 32)"
  fi
}

copy_vm_certificates_for_search() {
  local name
  is_macos || return 0
  for name in $(colima ssh -- ls "$VM_CA_DIR" 2>/dev/null | grep '\.crt$' || true); do
    colima ssh -- cat "$VM_CA_DIR/$name" >"$SEARCH_CA_DIR/$name" 2>/dev/null || true
  done
}

search_provider() {
  local configured
  configured="$(sed -n 's/^VED_SEARCH_PROVIDER=//p' "$BACKEND/.env" 2>/dev/null | tail -n 1)"
  configured="$(printf '%s' "$configured" | tr -d "\"' " | tr '[:upper:]' '[:lower:]')"
  printf '%s' "${configured:-$SEARXNG_PROVIDER}"
}

uses_searxng() { [ "$(search_provider)" = "$SEARXNG_PROVIDER" ]; }

db_services() {
  if uses_searxng; then
    printf '%s\n' --profile "$SEARCH_PROFILE" up -d db search
  else
    printf '%s\n' up -d db
  fi
}

cmd_phone() {
  local tailscale host web_url api_url
  tailscale="$(find_tailscale)"
  [ -n "$tailscale" ] || fail "Tailscale is not installed. See docs/phone-access.md"

  if [ "${1:-}" = "off" ]; then
    say "removing the Tailscale serve config for Ved"
    "$tailscale" serve --https="$PHONE_WEB_PORT" off || true
    "$tailscale" serve --https="$PHONE_API_PORT" off || true
    say "done. Env values are left as they are; local use still works"
    return
  fi
  [ -z "${1:-}" ] || fail "unknown option: $1 (use ./ved phone or ./ved phone off)"

  host="$(tailnet_hostname "$tailscale")"
  [ -n "$host" ] || fail "Tailscale is not logged in or not running. Sign in, then retry."
  web_url="https://$host"
  api_url="https://$host:$PHONE_API_PORT"

  say "serving Ved to your tailnet only (not the public internet)"
  "$tailscale" serve --bg --https="$PHONE_WEB_PORT" "http://127.0.0.1:$WEB_PORT" ||
    fail "tailscale serve failed. If it asks to enable HTTPS, see docs/phone-access.md"
  "$tailscale" serve --bg --https="$PHONE_API_PORT" "http://127.0.0.1:$BACKEND_PORT" ||
    fail "tailscale serve failed for the backend port"

  say "writing env values"
  set_env_value "$WEB/.env.local" NEXT_PUBLIC_VED_API_URL "$api_url"
  set_env_value "$WEB/.env.local" VED_TAILNET_HOST "$host"
  allow_cors_origin "$BACKEND/.env" "$web_url"

  printf '\nOpen on your phone:  %s\n' "$web_url"
  printf '\nRestart ./ved api and ./ved web so they pick up:\n'
  printf '  apps/web-client/.env.local  NEXT_PUBLIC_VED_API_URL=%s\n' "$api_url"
  printf '  apps/web-client/.env.local  VED_TAILNET_HOST=%s\n' "$host"
  printf '  apps/backend/.env           VED_CORS_ALLOW_ORIGINS includes "%s"\n' "$web_url"
  printf '\nThe Mac itself must stay awake and signed in to Tailscale.\n'
}

cmd_db() {
  local services=()
  ensure_env_files
  while IFS= read -r word; do services+=("$word"); done < <(db_services)
  ensure_docker
  if uses_searxng; then
    ensure_search_secret
    copy_vm_certificates_for_search
    say "starting Postgres and SearXNG"
  else
    say "starting Postgres (web search uses $(search_provider), not SearXNG)"
  fi
  compose "${services[@]}"
}

cmd_model() {
  if port_in_use "$OLLAMA_PORT"; then
    say "Ollama is already running on :$OLLAMA_PORT"
    return
  fi
  say "starting Ollama (Ctrl+C to stop)"
  OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=q8_0 exec ollama serve
}

cmd_api() {
  ensure_env_files
  if port_in_use "$BACKEND_PORT"; then
    fail "port $BACKEND_PORT is taken. If it's the Docker backend: ./ved stop"
  fi
  say "starting backend on :$BACKEND_PORT (Ctrl+C to stop)"
  cd "$BACKEND"
  exec uv run uvicorn ved_backend.main:app --reload --port "$BACKEND_PORT"
}

cmd_web() {
  say "starting web client on :$WEB_PORT (Ctrl+C to stop)"
  cd "$WEB"
  exec npm run dev
}

cmd_migrate() {
  say "applying database migrations"
  cd "$BACKEND"
  uv run alembic upgrade head
}

cmd_studio() {
  ensure_docker
  say "starting the DB browser on http://localhost:5050"
  compose --profile tools up -d studio
}

cmd_status() {
  local name port
  for entry in "Postgres:5432" "Ollama:$OLLAMA_PORT" "backend:$BACKEND_PORT" "web:3000" "SearXNG:$SEARCH_PORT" "DB browser:5050"; do
    name="${entry%%:*}"
    port="${entry##*:}"
    if port_in_use "$port"; then
      printf '  \033[32m●\033[0m %-11s :%s\n' "$name" "$port"
    else
      printf '  \033[2m○\033[0m %-11s :%s\n' "$name" "$port"
    fi
  done
}

cmd_stop() {
  say "stopping the Docker backend, if running"
  compose stop backend >/dev/null 2>&1 || true
  say "done. Terminals started with ./ved model|api|web stop with Ctrl+C"
}

cmd_down() {
  say "stopping all containers"
  compose --profile tools --profile "$SEARCH_PROFILE" stop
  if is_macos; then
    say "stopping Colima"
    colima stop
  fi
}

cmd_setup() {
  say "creating env files (existing ones are kept)"
  [ -f "$INFRA/.env" ] || cp "$INFRA/.env.example" "$INFRA/.env"
  [ -f "$BACKEND/.env" ] || cp "$BACKEND/.env.example" "$BACKEND/.env"
  [ -f "$WEB/.env.local" ] || cp "$WEB/.env.example" "$WEB/.env.local"

  if ! grep -q '^POSTGRES_PASSWORD=.' "$INFRA/.env"; then
    printf '\nSet a password first:\n'
    printf '  1. infra/.env          POSTGRES_PASSWORD=<choose one>\n'
    printf '  2. apps/backend/.env   use the same password in VED_DATABASE_URL\n'
    printf '\nThen run ./ved setup again.\n'
    exit 1
  fi

  say "installing Python dependencies"
  (cd "$REMINDERS" && uv sync)
  (cd "$PEOPLE" && uv sync)
  (cd "$MEMORY" && uv sync)
  (cd "$WEB_TOOLS" && uv sync)
  (cd "$BACKEND" && uv sync)

  if grep -q '^VED_VAPID_PRIVATE_KEY=.' "$BACKEND/.env"; then
    say "push keys already exist, keeping them"
  else
    say "generating push keys"
    (cd "$BACKEND" && uv run python scripts/generate_vapid_keys.py)
  fi

  cmd_db
  say "waiting for Postgres"
  until compose exec -T db pg_isready -U ved >/dev/null 2>&1; do sleep 1; done
  cmd_migrate

  say "installing web dependencies"
  (cd "$WEB" && npm install)

  local missing=""
  for model in "$(configured_model)" "$EMBEDDING_MODEL"; do
    ollama list 2>/dev/null | grep -q "^${model%%:*}" || missing="$missing $model"
  done
  if [ -n "$missing" ]; then
    printf '\nOne more step. Start ./ved model, then in another terminal:\n'
    for model in $missing; do printf '  ollama pull %s\n' "$model"; done
    printf 'The embedding model is small; the chat model size depends on VED_LLM_MODEL.\n'
  fi

  printf '\nSetup done. Start Ved with ./ved db, then in three terminals:\n'
  printf '  ./ved model\n  ./ved api\n  ./ved web\n'
}

cmd_help() {
  cat <<'EOF'
Usage: ./ved <command>

First time
  setup     Create env files, install dependencies, generate push keys,
            start Postgres and apply migrations

Every time
  db        Start Postgres (and Colima on a Mac), plus SearXNG when it is
            the search provider (runs in the background)
  model     Start Ollama, the local model        (keep this terminal open)
  api       Start the backend on :8000           (keep this terminal open)
  web       Start the web client on :3000        (keep this terminal open)

Other
  status    Show which services are running
  migrate   Apply new database migrations
  studio    Start the DB browser on :5050
  phone     Reach Ved from your phone over Tailscale (see docs/phone-access.md)
  phone off Stop serving Ved to your phone
  stop      Stop the Docker backend, freeing :8000
  down      Stop all containers (and Colima on a Mac)
EOF
}

case "${1:-help}" in
  setup) cmd_setup ;;
  db) cmd_db ;;
  model) cmd_model ;;
  api) cmd_api ;;
  web) cmd_web ;;
  migrate) cmd_migrate ;;
  studio) cmd_studio ;;
  phone) shift; cmd_phone "$@" ;;
  status) cmd_status ;;
  stop) cmd_stop ;;
  down) cmd_down ;;
  help | -h | --help) cmd_help ;;
  *) printf 'Unknown command: %s\n\n' "$1" >&2; cmd_help; exit 1 ;;
esac
